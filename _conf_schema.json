{
  "enable_memory": {
    "description": "启用分层记忆系统",
    "type": "bool",
    "default": true,
    "hint": "全局开关，控制是否启用 L1/L2/L3 记忆自动召回与归档"
  },
  "db_path": {
    "description": "记忆数据库文件路径",
    "type": "string",
    "default": "",
    "hint": "留空则使用 <AstrBot数据目录>/plugin_data/astrbot_plugin_agent_memory/agent_memory.db；也可填写完整 .db 文件路径或目录"
  },
  "summary_turn_interval": {
    "description": "多轮缓冲总结阈值（轮）",
    "type": "int",
    "default": 5,
    "hint": "同一会话累积 N 轮对话后才打包触发一次后台总结，减少 LLM 调用；会话结束或插件关闭时会强制冲洗剩余轮次"
  },
  "memory_injection_enable": {
    "description": "启用记忆前置注入（Prompt Injection）",
    "type": "bool",
    "default": true,
    "hint": "关闭后 LLM 请求不再被注入长期记忆，但轮次沉淀（后置记录）仍然生效"
  },
  "summarizer_queue_maxsize": {
    "description": "后台总结队列最大容量",
    "type": "int",
    "default": 1000,
    "hint": "队列满时降级写入 task_dlq 死信表，绝不阻塞主对话链路"
  },
  "summarizer": {
    "description": "独立总结与提炼模型配置",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "LLM 提供商 ID (留空则复用当前会话模型)",
        "type": "string",
        "default": "",
        "hint": "建议配置轻量高性价比模型用于后台 L1/L2/L3 记忆提炼"
      },
      "embedding_provider_id": {
        "description": "Embedding 提供商 ID",
        "type": "string",
        "default": "",
        "hint": "用于 L2 情景记忆向量化检索"
      },
      "max_concurrency": {
        "description": "后台总结最大并发数",
        "type": "int",
        "default": 2
      },
      "timeout_seconds": {
        "description": "总结请求超时时间(秒)",
        "type": "int",
        "default": 45
      },
      "summary_turn_interval": {
        "description": "多轮缓冲总结阈值(轮)",
        "type": "int",
        "default": 5,
        "hint": "与顶层配置等效，顶层优先；建议 3~8 轮"
      },
      "api_base": {
        "description": "总结 LLM API 地址(OpenAI 兼容)",
        "type": "string",
        "default": ""
      },
      "api_key": {
        "description": "总结 LLM API 密钥",
        "type": "string",
        "default": ""
      },
      "model": {
        "description": "总结 LLM 模型名称",
        "type": "string",
        "default": ""
      }
    }
  },
  "models": {
    "description": "向量化与重排模型配置",
    "type": "object",
    "items": {
      "embedding": {
        "description": "Embedding 模型",
        "type": "object",
        "items": {
          "api_base": {
            "description": "API 地址",
            "type": "string",
            "default": "https://api.siliconflow.cn/v1"
          },
          "api_key": {
            "description": "API 密钥",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型名称",
            "type": "string",
            "default": "BAAI/bge-m3"
          },
          "dim": {
            "description": "向量维度",
            "type": "int",
            "default": 1024
          },
          "timeout": {
            "description": "请求超时(秒)",
            "type": "float",
            "default": 30.0
          }
        }
      },
      "rerank": {
        "description": "重排模型",
        "type": "object",
        "items": {
          "api_base": {
            "description": "API 地址",
            "type": "string",
            "default": "https://api.siliconflow.cn/v1"
          },
          "api_key": {
            "description": "API 密钥",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型名称",
            "type": "string",
            "default": "BAAI/bge-reranker-v2-m3"
          },
          "timeout": {
            "description": "请求超时(秒)",
            "type": "float",
            "default": 20.0
          },
          "rrf_k": {
            "description": "RRF 融合常数 k",
            "type": "int",
            "default": 60
          }
        }
      }
    }
  },
  "retrieval": {
    "description": "混合检索与权重参数",
    "type": "object",
    "items": {
      "top_k": {
        "description": "单次召回最大记忆条数",
        "type": "int",
        "default": 6
      },
      "weight_vector": {
        "description": "向量语义相似度权重",
        "type": "float",
        "default": 0.55
      },
      "weight_bm25": {
        "description": "BM25 关键词检索权重",
        "type": "float",
        "default": 0.3
      },
      "weight_importance": {
        "description": "重要度与时间衰减权重",
        "type": "float",
        "default": 0.15
      },
      "retrieve_timeout": {
        "description": "前置检索最大等待时长（秒）",
        "type": "float",
        "default": 3.0,
        "hint": "超时即静默降级跳过本次注入，绝不拖慢主对话链路"
      },
      "prompt_injection_max_chars": {
        "description": "注入 System Prompt 的记忆块字符上限",
        "type": "int",
        "default": 2000,
        "hint": "0 表示不限制；超长会被截断，避免挤占人格提示词"
      },
      "inject_position": {
        "description": "记忆块注入位置",
        "type": "string",
        "default": "system_head",
        "hint": "system_head=System Prompt 最前端（默认，推荐 Claude/GPT-4o）；system_tail=System Prompt 最末端（紧贴人设之后）；user_head=用户 Query 最前端（推荐 DeepSeek/Qwen 等对即时提问敏感的模型）"
      },
      "record_dedup_window": {
        "description": "轮次记录去重时间窗（秒）",
        "type": "float",
        "default": 2.0,
        "hint": "同一会话相同内容在该窗口内只记录一次，抵御宿主重复回调"
      }
    }
  },
  "migration": {
    "description": "旧记忆资产迁移配置",
    "type": "object",
    "items": {
      "auto_detect_legacy": {
        "description": "启动时自动检测旧插件记忆资产",
        "type": "bool",
        "default": true
      },
      "source_db_path": {
        "description": "旧版 livingmemory.db 路径",
        "type": "string",
        "default": "",
        "hint": "留空则自动探测 astrbot_plugin_livingmemory 插件数据目录下的 livingmemory.db"
      },
      "force": {
        "description": "目标库非空时仍强制迁移",
        "type": "bool",
        "default": false,
        "hint": "开启后 /memory migrate 会覆盖合并写入已有数据，请谨慎使用"
      },
      "dry_run": {
        "description": "仅预览迁移统计不写入",
        "type": "bool",
        "default": false,
        "hint": "开启后 /memory migrate 只做只读统计，不修改目标库"
      }
    }
  },
  "webui": {
    "description": "专属记忆管理 WebUI 配置",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用专属 WebUI 面板",
        "type": "bool",
        "default": false
      },
      "host": {
        "description": "监听地址",
        "type": "string",
        "default": "127.0.0.1"
      },
      "port": {
        "description": "监听端口",
        "type": "int",
        "default": 18899
      },
      "access_token": {
        "description": "WebUI 访问令牌",
        "type": "string",
        "default": ""
      }
    }
  }
}
