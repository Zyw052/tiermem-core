{
  "enable_memory": {
    "description": "启用分层记忆",
    "type": "bool",
    "default": true,
    "hint": "总开关：L1 原始对话落盘、L2 情景记忆、L3 图谱与自动召回。"
  },
  "memory_injection_enable": {
    "description": "启用记忆注入",
    "type": "bool",
    "default": true,
    "hint": "开启后每轮对话前检索长期记忆并注入提示词；关闭仅保留沉淀，不再注入。"
  },
  "summary_turn_interval": {
    "description": "总结触发轮次",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 20,
      "step": 1
    },
    "hint": "同一会话累积 N 轮后打包做一次后台总结，减少 LLM 调用。建议 3~8。"
  },
  "llm_provider_id": {
    "description": "总结模型服务商",
    "type": "string",
    "_special": "select_provider",
    "default": "",
    "hint": "直接下拉选择 AstrBot 已配置的对话服务商，用于后台记忆提炼；留空则回退下方「总结模型」手动配置。"
  },
  "embedding_provider_id": {
    "description": "向量化服务商 ID",
    "type": "string",
    "default": "",
    "hint": "填写 AstrBot「服务提供商」中 Embedding 类型服务的 ID（可打开本插件「记忆面板」页面用下拉框挑选）。留空则回退手动 API 配置，再退化为零向量。"
  },
  "rerank_provider_id": {
    "description": "重排服务商 ID",
    "type": "string",
    "default": "",
    "hint": "填写 Rerank 类型服务的 ID（同样可在「记忆面板」页面下拉挑选）。留空则回退本地 RRF 融合重排。"
  },
  "judge_provider_id": {
    "description": "判官模型服务商",
    "type": "string",
    "_special": "select_provider",
    "default": "",
    "hint": "自作判定门禁（信息价值打分 / 冲突检测）使用。建议选廉价快速模型；留空则复用总结模型服务商。"
  },
  "db_path": {
    "description": "记忆数据库路径",
    "type": "string",
    "default": "",
    "hint": "留空使用插件数据目录下的 agent_memory.db；可填完整 .db 路径或目录。"
  },
  "summarizer_queue_maxsize": {
    "description": "总结队列容量",
    "type": "int",
    "default": 1000,
    "invisible": true
  },
  "summary_idle_flush_seconds": {
    "description": "会话静默刷盘阈值(秒)",
    "type": "int",
    "default": 180,
    "invisible": true
  },
  "retrieval": {
    "description": "检索与注入",
    "hint": "召回条数、注入位置与注入长度上限；其余高级参数已隐藏，可在「记忆面板」页面查看与调优。",
    "type": "object",
    "items": {
      "top_k": {
        "description": "单次召回条数",
        "type": "int",
        "default": 6,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "hint": "每次注入最多带入多少条记忆，建议 4~8。"
      },
      "inject_position": {
        "description": "注入位置",
        "type": "string",
        "default": "system_head",
        "options": [
          "system_head",
          "system_tail",
          "user_head"
        ],
        "hint": "system_head=系统提示最前；system_tail=人设之后；user_head=用户提问最前。"
      },
      "prompt_injection_max_chars": {
        "description": "注入字符上限",
        "type": "int",
        "default": 2000,
        "slider": {
          "min": 0,
          "max": 8000,
          "step": 100
        },
        "hint": "0 表示不限制；过大可能挤占人格提示词。"
      },
      "weight_vector": {
        "description": "向量权重",
        "type": "float",
        "default": 0.55,
        "invisible": true
      },
      "weight_bm25": {
        "description": "BM25 权重",
        "type": "float",
        "default": 0.3,
        "invisible": true
      },
      "weight_importance": {
        "description": "重要度权重",
        "type": "float",
        "default": 0.15,
        "invisible": true
      },
      "retrieve_timeout": {
        "description": "检索超时(秒)",
        "type": "float",
        "default": 3.0,
        "invisible": true
      },
      "record_dedup_window": {
        "description": "轮次去重窗口(秒)",
        "type": "float",
        "default": 2.0,
        "invisible": true
      },
      "strict_session_isolation": {
        "description": "严格会话隔离",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "access_flush_interval": {
        "description": "访问计数刷盘间隔(秒)",
        "type": "float",
        "default": 60.0,
        "invisible": true
      },
      "access_flush_threshold": {
        "description": "访问计数刷盘阈值",
        "type": "int",
        "default": 200,
        "invisible": true
      },
      "recall_pool_limit": {
        "description": "粗排候选池上限",
        "type": "int",
        "default": 500,
        "invisible": true
      },
      "matrix_cache_sync_interval": {
        "description": "向量矩阵校验间隔(秒)",
        "type": "float",
        "default": 5.0,
        "invisible": true
      },
      "graph_recall_enabled": {
        "description": "启用图谱关联召回",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "graph_entity_limit": {
        "description": "图谱种子实体上限",
        "type": "int",
        "default": 5,
        "invisible": true
      },
      "graph_edge_limit": {
        "description": "图谱关联边上限",
        "type": "int",
        "default": 20,
        "invisible": true
      },
      "graph_score_bonus": {
        "description": "图谱关联加分",
        "type": "float",
        "default": 0.15,
        "invisible": true
      },
      "decay_enabled": {
        "description": "启用时间衰减",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "decay_lambda": {
        "description": "衰减速率 λ",
        "type": "float",
        "default": 1.0,
        "invisible": true
      },
      "decay_floor": {
        "description": "衰减下限",
        "type": "float",
        "default": 0.05,
        "invisible": true
      },
      "max_pinned_l3": {
        "description": "置顶记忆注入上限",
        "type": "int",
        "default": 15,
        "invisible": true
      }
    }
  },
  "evaluator": {
    "description": "自作判定门禁",
    "hint": "入库前用廉价模型给事实打信息价值分并检测冲突；失败自动降级为本地规则，不会阻断记忆主链路。",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用判定门禁",
        "type": "bool",
        "default": true
      },
      "model_name": {
        "description": "判官模型名称",
        "type": "string",
        "default": "jev",
        "hint": "主人指定默认 jev；实际模型以所选服务商为准，此处用于日志与提示。"
      },
      "api_base": {
        "description": "判官 API 地址",
        "type": "string",
        "default": "",
        "invisible": true
      },
      "api_key": {
        "description": "判官 API 密钥",
        "type": "string",
        "default": "",
        "secret": true,
        "invisible": true
      },
      "timeout_seconds": {
        "description": "判官超时(秒)",
        "type": "float",
        "default": 8.0,
        "invisible": true
      },
      "min_value_score": {
        "description": "价值分阈值",
        "type": "float",
        "default": 0.35,
        "invisible": true
      },
      "fallback_min_value_score": {
        "description": "降级阈值",
        "type": "float",
        "default": 0.175,
        "invisible": true
      },
      "conflict_check": {
        "description": "冲突检测",
        "type": "bool",
        "default": true,
        "invisible": true
      },
      "conflict_similarity": {
        "description": "冲突相似度下限",
        "type": "float",
        "default": 0.5,
        "invisible": true
      },
      "max_candidates": {
        "description": "冲突比对候选数",
        "type": "int",
        "default": 8,
        "invisible": true
      },
      "fail_open": {
        "description": "失败时保留事实",
        "type": "bool",
        "default": true,
        "invisible": true
      }
    }
  },
  "graph": {
    "description": "知识图谱（L3）",
    "hint": "从记忆中抽取 (主体, 关系, 客体) 三元组，支撑多跳关联召回。",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用图谱抽取",
        "type": "bool",
        "default": true,
        "hint": "关闭后不再写入 kg_nodes / kg_edges，检索侧图路召回同步失效。"
      },
      "max_triples_per_fact": {
        "description": "单事实三元组上限",
        "type": "int",
        "default": 6,
        "invisible": true
      },
      "edge_confidence": {
        "description": "规则关系置信度",
        "type": "float",
        "default": 0.9,
        "invisible": true
      }
    }
  },
  "noise_filter": {
    "description": "系统噪声过滤",
    "hint": "拦截注入到会话里的系统块与后台回调（子代理任务完成、项目大盘、RAG 标记、system_reminder 等），避免污染长期记忆。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用噪声过滤",
        "type": "bool",
        "default": true,
        "hint": "关闭后系统块会被当作正常对话写入记忆（不建议）。"
      },
      "strip_inline": {
        "description": "清洗行内噪声",
        "type": "bool",
        "default": true,
        "hint": "开启后不仅整段丢弃，还会把夹杂在正常文本中的系统块剔除，只保留有效内容。"
      }
    }
  },
  "webui": {
    "description": "记忆面板（插件页面）",
    "hint": "在 AstrBot「插件」页打开本插件页面即可查看通电自检、L1/L2/KG/DLQ 统计、记忆浏览与噪声排查；面板内「配置」页签可在线查看并保存本插件配置（密钥掩码显示），不依赖原生配置弹窗、不会自动重载或重启。",
    "type": "object",
    "items": {
      "register_api": {
        "description": "注册页面数据接口",
        "type": "bool",
        "default": true,
        "hint": "关闭后插件页面仍可打开，但数据接口返回 404。改动需重载插件生效。"
      },
      "allow_config_write": {
        "description": "允许面板保存配置",
        "type": "bool",
        "default": true,
        "hint": "关闭后面板「配置」页签仍可查看，但保存接口会拒绝写入（只读模式）。适合多人共管时锁定配置。"
      }
    }
  },
  "summarizer": {
    "description": "总结模型（手动配置兜底）",
    "hint": "仅当上方「总结模型服务商」留空时使用；已选服务商时这里的配置不会覆盖服务商。",
    "type": "object",
    "invisible": true,
    "items": {
      "provider_id": {
        "description": "LLM 服务商 ID",
        "type": "string",
        "default": ""
      },
      "embedding_provider_id": {
        "description": "Embedding 服务商 ID",
        "type": "string",
        "default": ""
      },
      "rerank_provider_id": {
        "description": "Rerank 服务商 ID",
        "type": "string",
        "default": ""
      },
      "max_concurrency": {
        "description": "后台总结并发数",
        "type": "int",
        "default": 2
      },
      "timeout_seconds": {
        "description": "总结超时(秒)",
        "type": "int",
        "default": 45
      },
      "summary_turn_interval": {
        "description": "总结触发轮次(兼容旧键)",
        "type": "int",
        "default": 5
      },
      "api_base": {
        "description": "手动 API 地址",
        "type": "string",
        "default": ""
      },
      "api_key": {
        "description": "手动 API 密钥",
        "type": "string",
        "default": "",
        "secret": true
      },
      "model": {
        "description": "手动模型名称",
        "type": "string",
        "default": ""
      },
      "dlq_retry_enabled": {
        "description": "死信自动重试",
        "type": "bool",
        "default": true
      },
      "dlq_retry_interval": {
        "description": "死信巡检间隔(秒)",
        "type": "float",
        "default": 60.0
      },
      "dlq_batch_size": {
        "description": "单轮死信处理条数",
        "type": "int",
        "default": 10
      },
      "dlq_base_backoff": {
        "description": "死信退避基数(秒)",
        "type": "float",
        "default": 60.0
      },
      "dlq_max_backoff": {
        "description": "死信退避上限(秒)",
        "type": "float",
        "default": 3600.0
      },
      "dlq_max_retries": {
        "description": "死信最大重试次数",
        "type": "int",
        "default": 3
      }
    }
  },
  "models": {
    "description": "手动向量化与重排模型",
    "hint": "仅当未选择宿主 Embedding / Rerank 服务商时生效（服务商优先）。",
    "type": "object",
    "invisible": true,
    "items": {
      "embedding": {
        "description": "Embedding 模型",
        "type": "dict",
        "items": {},
        "hint": "自由键值映射（api_base / api_key / model / dim / timeout）。使用 dict 而非嵌套 object，避免旧版配置弹窗递归渲染异常；密钥字段在原生配置页与记忆面板均按掩码显示。",
        "default": {
          "api_base": "",
          "api_key": "",
          "model": "BAAI/bge-m3",
          "dim": 1024,
          "timeout": 30.0
        }
      },
      "rerank": {
        "description": "Rerank 模型",
        "type": "dict",
        "items": {},
        "hint": "自由键值映射（api_base / api_key / model / timeout / rrf_k）。",
        "default": {
          "api_base": "",
          "api_key": "",
          "model": "BAAI/bge-reranker-v2-m3",
          "timeout": 20.0,
          "rrf_k": 60
        }
      }
    }
  },
  "migration": {
    "description": "旧记忆资产迁移",
    "type": "object",
    "invisible": true,
    "items": {
      "auto_detect_legacy": {
        "description": "自动检测旧资产",
        "type": "bool",
        "default": true
      },
      "source_db_path": {
        "description": "旧库路径",
        "type": "string",
        "default": ""
      },
      "force": {
        "description": "强制覆盖迁移",
        "type": "bool",
        "default": false
      },
      "dry_run": {
        "description": "仅预览不写入",
        "type": "bool",
        "default": false
      }
    }
  }
}
